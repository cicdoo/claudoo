<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="report_partner_ledger_sql">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="o">
                <t t-call="web.internal_layout">
                    <div class="page">
                        <h2>Partner Ledger</h2>
                        <div class="row">
                            <div class="col-6">
                                <strong>Date From:</strong> <span t-out="o.date_from"/>
                            </div>
                            <div class="col-6">
                                <strong>Date To:</strong> <span t-out="o.date_to"/>
                            </div>
                        </div>
                        <t t-set="grouped" t-value="lines_by_partner.get(o.id, {})"/>
                        <t t-foreach="grouped.items()" t-as="partner_lines">
                            <t t-set="partner" t-value="partner_lines[0]"/>
                            <t t-set="lines" t-value="partner_lines[1]"/>
                            <h4 style="margin-top: 20px;">
                                <span t-out="partner.display_name or 'Undefined'"/>
                            </h4>
                            <table class="table table-sm">
                                <thead>
                                    <tr>
                                        <th>Date</th>
                                        <th>Journal Entry</th>
                                        <th>Reference</th>
                                        <th>Journal</th>
                                        <th class="text-end">Debit</th>
                                        <th class="text-end">Credit</th>
                                        <th class="text-end">Balance</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <t t-foreach="lines" t-as="line">
                                        <tr t-if="line.line_type == 'opening'" class="fw-bold">
                                            <td colspan="4">Initial Balance</td>
                                            <td class="text-end"><span t-out="line.debit" t-options="{'widget': 'monetary', 'display_currency': o.company_id.currency_id}"/></td>
                                            <td class="text-end"><span t-out="line.credit" t-options="{'widget': 'monetary', 'display_currency': o.company_id.currency_id}"/></td>
                                            <td class="text-end"><span t-out="line.balance" t-options="{'widget': 'monetary', 'display_currency': o.company_id.currency_id}"/></td>
                                        </tr>
                                        <tr t-if="line.line_type == 'line'">
                                            <td><span t-out="line.date"/></td>
                                            <td><span t-out="line.move_name or line.move_id.name"/></td>
                                            <td><span t-out="line.ref"/></td>
                                            <td><span t-out="line.journal_id.code"/></td>
                                            <td class="text-end"><span t-out="line.debit" t-options="{'widget': 'monetary', 'display_currency': o.company_id.currency_id}"/></td>
                                            <td class="text-end"><span t-out="line.credit" t-options="{'widget': 'monetary', 'display_currency': o.company_id.currency_id}"/></td>
                                            <td class="text-end"><span t-out="line.balance" t-options="{'widget': 'monetary', 'display_currency': o.company_id.currency_id}"/></td>
                                        </tr>
                                        <tr t-if="line.line_type == 'closing'" class="fw-bold border-top">
                                            <td colspan="4">Ending Balance</td>
                                            <td class="text-end"><span t-out="line.debit" t-options="{'widget': 'monetary', 'display_currency': o.company_id.currency_id}"/></td>
                                            <td class="text-end"><span t-out="line.credit" t-options="{'widget': 'monetary', 'display_currency': o.company_id.currency_id}"/></td>
                                            <td class="text-end"><span t-out="line.balance" t-options="{'widget': 'monetary', 'display_currency': o.company_id.currency_id}"/></td>
                                        </tr>
                                    </t>
                                </tbody>
                            </table>
                        </t>
                    </div>
                </t>
            </t>
        </t>
    </template>
</odoo>
