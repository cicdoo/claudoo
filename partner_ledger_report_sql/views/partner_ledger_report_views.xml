<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_partner_ledger_report_wizard_form" model="ir.ui.view">
        <field name="name">partner.ledger.report.wizard.form</field>
        <field name="model">partner.ledger.report.wizard</field>
        <field name="arch" type="xml">
            <form string="Partner Ledger (SQL)">
                <group>
                    <group>
                        <field name="company_id" groups="base.group_multi_company"/>
                        <field name="date_from"/>
                        <field name="date_to"/>
                        <field name="partner_ids" widget="many2many_tags"/>
                    </group>
                    <group>
                        <field name="account_type" widget="radio"/>
                        <field name="target_move" widget="radio"/>
                    </group>
                </group>
                <footer>
                    <button name="action_view_report" type="object" string="View Report" class="btn-primary"/>
                    <button name="action_print_pdf" type="object" string="Print PDF" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_partner_ledger_report_wizard" model="ir.actions.act_window">
        <field name="name">Partner Ledger (SQL)</field>
        <field name="res_model">partner.ledger.report.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

    <record id="view_partner_ledger_report_line_list" model="ir.ui.view">
        <field name="name">partner.ledger.report.line.list</field>
        <field name="model">partner.ledger.report.line</field>
        <field name="arch" type="xml">
            <list string="Partner Ledger (SQL)" default_group_by="partner_id" create="0" edit="0" delete="0">
                <field name="partner_id"/>
                <field name="date"/>
                <field name="move_id"/>
                <field name="move_name"/>
                <field name="journal_id"/>
                <field name="ref"/>
                <field name="line_type" optional="hide"/>
                <field name="sequence" invisible="1"/>
                <field name="debit" sum="Total"/>
                <field name="credit" sum="Total"/>
                <field name="balance"/>
                <field name="currency_id" invisible="1"/>
            </list>
        </field>
    </record>

    <record id="view_partner_ledger_report_line_pivot" model="ir.ui.view">
        <field name="name">partner.ledger.report.line.pivot</field>
        <field name="model">partner.ledger.report.line</field>
        <field name="arch" type="xml">
            <pivot string="Partner Ledger (SQL)">
                <field name="partner_id" type="row"/>
                <field name="line_type" type="col"/>
                <field name="debit" type="measure"/>
                <field name="credit" type="measure"/>
                <field name="balance" type="measure"/>
            </pivot>
        </field>
    </record>

    <record id="view_partner_ledger_report_line_search" model="ir.ui.view">
        <field name="name">partner.ledger.report.line.search</field>
        <field name="model">partner.ledger.report.line</field>
        <field name="arch" type="xml">
            <search string="Partner Ledger (SQL)">
                <field name="partner_id"/>
                <field name="move_name"/>
                <field name="journal_id"/>
                <filter name="group_by_partner" string="Partner" context="{'group_by': 'partner_id'}"/>
            </search>
        </field>
    </record>
</odoo>
