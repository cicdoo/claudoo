<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_account_billcom_log_list" model="ir.ui.view">
        <field name="name">account.billcom.log.list</field>
        <field name="model">account.billcom.log</field>
        <field name="arch" type="xml">
            <list create="0" edit="0" default_order="create_date desc">
                <field name="create_date"/>
                <field name="res_model"/>
                <field name="res_id"/>
                <field name="direction"/>
                <field name="status" decoration-danger="status == 'error'" decoration-success="status == 'success'"/>
                <field name="error_message" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="view_account_billcom_log_form" model="ir.ui.view">
        <field name="name">account.billcom.log.form</field>
        <field name="model">account.billcom.log</field>
        <field name="arch" type="xml">
            <form create="0" edit="0">
                <sheet>
                    <group>
                        <field name="create_date"/>
                        <field name="res_model"/>
                        <field name="res_id"/>
                        <field name="direction"/>
                        <field name="status"/>
                    </group>
                    <notebook>
                        <page string="Request" name="request">
                            <field name="request_payload" widget="text"/>
                        </page>
                        <page string="Response" name="response">
                            <field name="response_payload" widget="text"/>
                        </page>
                        <page string="Error" name="error" invisible="status != 'error'">
                            <field name="error_message" widget="text"/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_account_billcom_log" model="ir.actions.act_window">
        <field name="name">Bill.com Sync Log</field>
        <field name="res_model">account.billcom.log</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="menu_account_billcom_log"
              name="Bill.com Sync Log"
              parent="account.menu_finance_configuration"
              action="action_account_billcom_log"
              groups="account.group_account_invoice"
              sequence="60"/>
</odoo>
