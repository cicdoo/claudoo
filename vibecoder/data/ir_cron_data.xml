<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record id="ir_cron_vibecoder_reap_idle_previews" model="ir.cron">
            <field name="name">Vibecoder: reap idle preview processes</field>
            <field name="model_id" ref="model_vibecoder_project"/>
            <field name="state">code</field>
            <field name="code">model._cron_reap_idle_previews()</field>
            <field name="interval_number">10</field>
            <field name="interval_type">minutes</field>
            <field name="active">True</field>
        </record>

        <record id="ir_cron_vibecoder_reap_stale_runs" model="ir.cron">
            <field name="name">Vibecoder: reap stale Claude runs</field>
            <field name="model_id" ref="model_vibecoder_session"/>
            <field name="state">code</field>
            <field name="code">model._cron_reap_stale()</field>
            <field name="interval_number">5</field>
            <field name="interval_type">minutes</field>
            <field name="active">True</field>
        </record>

        <record id="ir_cron_vibecoder_gc_login_attempts" model="ir.cron">
            <field name="name">Vibecoder: garbage-collect login throttle records</field>
            <field name="model_id" ref="model_vibecoder_login_attempt"/>
            <field name="state">code</field>
            <field name="code">model._cron_gc()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">hours</field>
            <field name="active">True</field>
        </record>
    </data>
</odoo>
